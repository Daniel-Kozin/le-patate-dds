rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // one document per player (name + machzor) per mode
    function isBoard(coll) {
      return coll in ['scores_normal', 'scores_hard', 'scores_eviatar', 'scores_minigames'];
    }
    function valid(d) {
      return d.keys().hasOnly(['name', 'machzor', 'score', 'tier', 'navy', 'games', 'at'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 16
        && d.machzor in ['ה', 'ו', 'ז', 'ח', 'ט', 'אחר']
        && d.score is int && d.score >= 0 && d.score <= 100000000
        && d.tier is int && d.tier >= 0 && d.tier <= 40
        && d.navy is bool
        && d.games is int && d.games >= 0
        && d.at is int;
    }

    match /{coll}/{player} {
      allow read: if isBoard(coll);
      allow create: if isBoard(coll) && valid(request.resource.data);
      // each player keeps their highest score from a single game
      allow update: if isBoard(coll) && valid(request.resource.data)
        && request.resource.data.score >= resource.data.score
        && request.resource.data.name == resource.data.name;
      allow delete: if false;
    }

    // game log for the admin panel: page visits, game starts and finished games
    match /log/{id} {
      allow read: if true;
      allow create: if request.resource.data.size() <= 20
        && request.resource.data.t in ['game', 'visit', 'start']
        && request.resource.data.at is int;
      allow update, delete: if false;
    }
  }
}
